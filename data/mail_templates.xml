<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Birthday Email Template -->
    <record id="birthday_wish_email_template" model="mail.template">
        <field name="name">Birthday Wish Email</field>
        <field name="model_id" ref="model_birthday_wish"/>
        <field name="email_from">{{ user.email or '' }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="subject">Happy Birthday {{ object.employee_id.name }}! 🎉</field>
        <field name="body_html" type="html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 style="color: #875A7B; font-size: 32px; margin: 0;">🎉 Happy Birthday! 🎉</h1>
    </div>
    
    <div style="background-color: #f8f9fa; border-radius: 10px; padding: 30px; margin-bottom: 20px;">
        <p style="font-size: 16px; line-height: 1.6; color: #333;">
            Dear <strong>{{ object.employee_id.name }}</strong>,
        </p>
        
        <p style="font-size: 16px; line-height: 1.6; color: #333;">
            On behalf of the entire team at <strong>{{ object.company_id.name }}</strong>, 
            we want to wish you a very happy birthday! 🎂
        </p>
        
        <p style="font-size: 16px; line-height: 1.6; color: #333;">
            May your special day be filled with joy, laughter, and wonderful moments. 
            We appreciate all your hard work and dedication throughout the year.
        </p>
        
        <p style="font-size: 16px; line-height: 1.6; color: #333;">
            Enjoy your day and celebrate in style!
        </p>
    </div>
    
    <div style="margin-top: 30px;">
        <p style="font-size: 16px; color: #333;">
            <strong>Best regards,</strong><br/>
            The {{ object.company_id.name }} Team
        </p>
    </div>
    
    <div style="text-align: center; margin-top: 40px; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px;">
        <p style="font-style: italic; color: white; font-size: 14px; margin: 0;">
            "The more you praise and celebrate your life, the more there is in life to celebrate."
        </p>
    </div>
</div>
        ]]></field>
        <field name="lang">{{ object.employee_id.lang or 'en_US' }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>