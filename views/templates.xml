<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Form View Extension -->
    <record id="view_employee_form_inherit_birthday_wish" model="ir.ui.view">
        <field name="name">hr.employee.form.birthday.wish</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add button to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_birthday_wishes" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-birthday-cake">
                    <field name="birthday_wish_count" widget="statinfo" string="Birthday Wishes"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>